# Public site URL (also baked in at Docker build time)
NEXT_PUBLIC_SITE_URL=https://anz.vn

# Outgoing mail (contact form + CV applications). Gmail SMTP with an App
# Password — myaccount.google.com/security → 2-Step Verification → App
# passwords. Without SMTP_USER/SMTP_PASS it logs instead of sending.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
CONTACT_NOTIFY_EMAIL=anz.team.vn@gmail.com

# Host port mapped to container :3000 (pick any free port on the server)
HOST_PORT=80

# Supabase — jobs, posts, and CV applications. Server-only, never NEXT_PUBLIC.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
